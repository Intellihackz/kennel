# Copy to .env and fill in. Nothing here is secret except SESSION_SECRET and RPC_URL if it carries a key.
PORT=8788
NODE_ENV=production
# Long random string. Without it, sign-ins end every time the server restarts.
SESSION_SECRET=
# Solana RPC over http. The public one is rate limited and cannot keep up with pump.fun, so use a keyed provider (Helius, Triton, QuickNode).
# It must allow websocket logsSubscribe. SOLANA_WS_URL is only needed if the websocket address is not the http one with ws:// instead.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
# Requests per second Kennel may send to the RPC. Set it to your plan's limit.
RPC_RPS=8
# Where the SQLite file lives. On a host, point this at a persistent volume.
DB_PATH=data/kennel.db
# A token is stored once it has this many trades (most pump.fun tokens die before that), and its trades are dropped after RETAIN_HOURS
# unless an agent was trained on it. Older tokens are read from the chain when someone adds them.
PROMOTE_TRADES=25
RETAIN_HOURS=72
# The platform token (its mint address on Solana). Payments are BURNED: the user burns PRICE_PER_TOKEN of it with an SPL burn
# instruction. Kennel collects nothing, so there is no treasury. While PLATFORM_TOKEN is empty, development mode adds tokens without
# burning anything, and production refuses to start orders.
PLATFORM_TOKEN=
PRICE_PER_TOKEN=100000
# Behind a proxy (Railway, Fly, nginx) so rate limits see the visitor's address. Name the header your host sets:
# Fly: fly-client-ip. Railway and most others: x-forwarded-for.
TRUST_PROXY=1
CLIENT_IP_HEADER=x-forwarded-for
# Build-time only (docker build --build-arg, or set before npm run build): the public address and the X account (no @).
# They go into every page's head: canonical links, share cards, sitemap. Leave empty until you know the address.
SITE_URL=
X_HANDLE=
# What passing the test means: "chance" (reliably better than random alerts, the default) or "rule" (also better than the simple rule by TEST_MARGIN).
TEST_GATE=chance
TEST_MARGIN=1.1
# The single outcome every agent learns: a net return of at least OBJ_X within OBJ_H hours, after fees and an allowance for extra costs.
OBJ_X=0.2
OBJ_H=3
